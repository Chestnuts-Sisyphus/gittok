.env
.DS_Store
node_modules/
dist/
# mcp-gittok 的单文件分发产物**有意入仓**（零安装：克隆后 node mcp-gittok/dist/index.js 即可跑，
# 也是 README / llms.txt 给 agent 的下载入口）；下面两条把它从上一行的 dist/ 规则里放行。
!mcp-gittok/dist/
!mcp-gittok/dist/**
social/
*.tsbuildinfo
web/dist/
web/node_modules/
# 仓内 Python venv：scripts/gittok-visual-check.py 需要 websocket-client，
# 本机纪律是「不许全局 pip install」（venv --system-site-packages 会写进系统 site-packages），
# 故依赖装在仓内 .venv：python -m venv .venv && .venv/Scripts/python -m pip install websocket-client
.venv/

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/
.impeccable/critique/*.png
# impeccable-ignore-end

# Internal dev docs — tracked locally, not published (public-facing repo hygiene)
PROGRESS.md
BLOCKED.md
.impeccable/

# 本地验证临时目录（不发布）
.tmp-verify/

# 部署期镜像目录（由 deploy-web.yml 在 CI 里生成：站点版 agent 文档与最近 7 天日报；
# 单一源是仓库里的 docs/API.md、skills/gittok/SKILL.md、mcp-gittok/README.md、digests/）
web/public/agent/
web/public/digests/

# 拆 job 刀（2026-09-05）：trending 快照只在 CI artifact 传递，几 MB/天不入仓
data/trending-snapshot.json

# vite prepare-feed 构建产物（六轮 G8）：从 data/feed.json 拆出的列表/详情表，
# 每次 npm run build / vite 都会重写；跟踪它只会污染 git status。
# 保留 feed.sample.json 作无源文件时的兜底；clone 后跑一次 build/dev 即生成。
web/public/data/feed.json
web/public/data/feed-details.json
web/public/data/following.json

# v3 提升流水线的上一版快照（字段回退闸对照用；体积与 feed.json 同量级，不入仓）
data/feed.prev.json

# 安全加固（2026-09-18 P0）：锚点/重判/稳定性实验产物，部分内嵌真实样式 API key，
# 一次 git add . 即入公开仓。只忽略，不删除本地文件。
data/anchor-probe*.json
data/rejudge-*.json
data/stability-*.json
data/zone-manual-check-*.json
tmp/

# 用户级交接物：含个人目录与凭据存放点路径，本仓 visibility=PUBLIC，禁止入库（只忽略不删本地文件）
AGENTS.md
.qoder/
__pycache__/
